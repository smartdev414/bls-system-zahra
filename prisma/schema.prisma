generator client {
  provider = "prisma-client"
  output   = "../app/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  ADMIN
  TUTOR
  STUDENT
}

enum CourseStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

enum CourseLevel {
  BEGINNER
  INTERMEDIATE
  ADVANCED
}

enum LessonType {
  VIDEO
  TEXT
  QUIZ
}

enum QuestionType {
  MULTIPLE_CHOICE
  TRUE_FALSE
}

enum AssetType {
  VIDEO
  PDF
  IMAGE
  DOCUMENT
  AUDIO
  SUBTITLE
}

enum LiveSessionStatus {
  SCHEDULED
  LIVE
  COMPLETED
  CANCELLED
}

enum LiveSessionVisibility {
  PUBLIC
  INVITE_ONLY
}

enum NotificationType {
  // Session events
  SESSION_SCHEDULED
  SESSION_STARTED
  SESSION_CANCELLED
  SESSION_DELETED
  SESSION_INVITE
  RECORDING_READY
  // Course / lesson events
  COURSE_PUBLISHED
  NEW_LESSON
  // Student activity (for tutors)
  NEW_ENROLLMENT
  NEW_REVIEW
  // Quiz results (for students)
  QUIZ_PASSED
  QUIZ_FAILED
  // Messaging
  NEW_MESSAGE
}

model User {
  id           String       @id @default(cuid())
  email        String       @unique
  passwordHash String?      // null for OAuth-only users
  googleId     String?      @unique
  name         String
  role         Role         @default(STUDENT)
  avatarUrl    String?
  bslLevel     CourseLevel? // relevant for STUDENT role
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt

  tutorProfile          TutorProfile?
  courses               Course[]                @relation("TutorCourses")
  quizAttempts          QuizAttempt[]
  hostedSessions        LiveSession[]           @relation("TutorLiveSessions")
  enrollments           Enrollment[]
  attendances           LiveSessionAttendance[]
  sessionInvites        LiveSessionInvite[]
  reviews               Review[]
  studentConversations  Conversation[]          @relation("StudentConversations")
  tutorConversations    Conversation[]          @relation("TutorConversations")
  sentMessages          Message[]               @relation("SentMessages")
  notifications         Notification[]
  studentGroups         StudentGroup[]          @relation("TutorStudentGroups")
  groupMemberships      StudentGroupMember[]
  sentInvites           TutorInvite[]           @relation("TutorInvites")
  invitedStudents       User[]                  @relation("InvitedByTutor")
  invitedBy             User?                   @relation("InvitedByTutor", fields: [invitedById], references: [id])
  invitedById           String?
}

model Notification {
  id        String           @id @default(cuid())
  userId    String
  type      NotificationType
  title     String
  body      String
  link      String?
  isRead    Boolean          @default(false)
  createdAt DateTime         @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([userId, isRead])
  @@index([createdAt])
}

model TutorProfile {
  id             String   @id @default(cuid())
  userId         String   @unique
  bio            String?
  qualifications String[] // e.g. ["CACDP Level 3", "Signature BSL"]
  isVerified     Boolean  @default(false)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Category {
  id      String   @id @default(cuid())
  name    String   @unique
  slug    String   @unique
  courses Course[]
}

model Sign {
  id          String      @id @default(cuid())
  word        String      @unique
  category    String
  level       CourseLevel @default(BEGINNER)
  description String
  videoUrl    String?
  imageUrl    String?
  handshape   String
  usage       String
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt

  @@index([category])
  @@index([level])
}

model Course {
  id           String       @id @default(cuid())
  tutorId      String
  categoryId   String?
  title        String
  slug         String       @unique
  description  String
  thumbnailUrl String?
  status       CourseStatus @default(DRAFT)
  level        CourseLevel  @default(BEGINNER)
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt

  tutor        User          @relation("TutorCourses", fields: [tutorId], references: [id])
  category     Category?     @relation(fields: [categoryId], references: [id])
  sections     Section[]
  enrollments  Enrollment[]
  liveSessions LiveSession[]
  reviews      Review[]

  @@index([tutorId])
  @@index([status])
}

model Section {
  id       String @id @default(cuid())
  courseId String
  title    String
  order    Int

  course  Course   @relation(fields: [courseId], references: [id], onDelete: Cascade)
  lessons Lesson[]

  @@index([courseId])
}

model Lesson {
  id          String     @id @default(cuid())
  sectionId   String
  title       String
  type        LessonType @default(VIDEO)
  description String?
  order       Int
  isFree      Boolean    @default(false)

  section   Section          @relation(fields: [sectionId], references: [id], onDelete: Cascade)
  assets    LessonAsset[]
  progress  LessonProgress[]
  questions QuizQuestion[]
  attempts  QuizAttempt[]

  @@index([sectionId])
}

model LessonAsset {
  id          String    @id @default(cuid())
  lessonId    String
  type        AssetType
  title       String
  description String?
  fileUrl     String
  fileName    String
  fileSize    Int?
  duration    Int?
  mimeType    String?
  order       Int       @default(0)
  createdAt   DateTime  @default(now())

  lesson Lesson @relation(fields: [lessonId], references: [id], onDelete: Cascade)

  @@index([lessonId])
}

model Enrollment {
  id          String    @id @default(cuid())
  studentId   String
  courseId    String
  enrolledAt  DateTime  @default(now())
  completedAt DateTime?

  student  User             @relation(fields: [studentId], references: [id])
  course   Course           @relation(fields: [courseId], references: [id])
  progress LessonProgress[]

  @@unique([studentId, courseId])
  @@index([courseId])
  @@index([studentId])
}

model LessonProgress {
  id           String    @id @default(cuid())
  enrollmentId String
  lessonId     String
  isCompleted  Boolean   @default(false)
  watchedSecs  Int       @default(0)
  completedAt  DateTime?
  updatedAt    DateTime  @updatedAt

  enrollment Enrollment @relation(fields: [enrollmentId], references: [id], onDelete: Cascade)
  lesson     Lesson     @relation(fields: [lessonId], references: [id], onDelete: Cascade)

  @@unique([enrollmentId, lessonId])
}

model LiveSession {
  id           String                 @id @default(cuid())
  tutorId      String
  courseId     String?
  title        String
  description  String?
  scheduledAt  DateTime
  durationMins Int
  roomName     String                 @unique
  maxStudents  Int?
  status       LiveSessionStatus      @default(SCHEDULED)
  visibility   LiveSessionVisibility  @default(PUBLIC)
  startedAt    DateTime?
  endedAt      DateTime?
  egressId     String?
  recordingKey String?
  recordingUrl String?
  createdAt    DateTime               @default(now())

  tutor       User                    @relation("TutorLiveSessions", fields: [tutorId], references: [id])
  course      Course?                 @relation(fields: [courseId], references: [id])
  attendances LiveSessionAttendance[]
  invites     LiveSessionInvite[]
  resources   LiveSessionResource[]

  @@index([tutorId])
  @@index([status])
  @@index([scheduledAt])
  @@index([visibility])
}

model LiveSessionInvite {
  id        String   @id @default(cuid())
  sessionId String
  studentId String
  invitedAt DateTime @default(now())

  session LiveSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  student User        @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@unique([sessionId, studentId])
  @@index([studentId])
}

model LiveSessionAttendance {
  id        String    @id @default(cuid())
  sessionId String
  studentId String
  joinedAt  DateTime?
  leftAt    DateTime?

  session LiveSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  student User        @relation(fields: [studentId], references: [id])

  @@unique([sessionId, studentId])
  @@index([studentId])
}

model Review {
  id        String   @id @default(cuid())
  studentId String
  courseId  String
  rating    Int      // 1–5
  comment   String?
  createdAt DateTime @default(now())

  student User   @relation(fields: [studentId], references: [id])
  course  Course @relation(fields: [courseId], references: [id])

  @@unique([studentId, courseId])
  @@index([courseId])
}

model Conversation {
  id            String    @id @default(cuid())
  studentId     String
  tutorId       String
  lastMessageAt DateTime  @default(now())
  createdAt     DateTime  @default(now())

  student  User      @relation("StudentConversations", fields: [studentId], references: [id])
  tutor    User      @relation("TutorConversations",   fields: [tutorId],   references: [id])
  messages Message[]

  @@unique([studentId, tutorId])
  @@index([studentId])
  @@index([tutorId])
}

model Message {
  id             String   @id @default(cuid())
  conversationId String
  senderId       String
  content        String
  isRead         Boolean  @default(false)
  createdAt      DateTime @default(now())

  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  sender       User         @relation("SentMessages", fields: [senderId], references: [id])

  @@index([conversationId])
  @@index([senderId])
}

model StudentGroup {
  id        String   @id @default(cuid())
  tutorId   String
  name      String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  tutor   User                 @relation("TutorStudentGroups", fields: [tutorId], references: [id], onDelete: Cascade)
  members StudentGroupMember[]

  @@index([tutorId])
}

model StudentGroupMember {
  groupId   String
  studentId String
  addedAt   DateTime @default(now())

  group   StudentGroup @relation(fields: [groupId], references: [id], onDelete: Cascade)
  student User         @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@id([groupId, studentId])
  @@index([studentId])
}

enum TutorInviteStatus {
  PENDING
  ACCEPTED
  EXPIRED
}

model TutorInvite {
  id        String            @id @default(cuid())
  tutorId   String
  email     String
  token     String            @unique @default(cuid())
  status    TutorInviteStatus @default(PENDING)
  expiresAt DateTime
  createdAt DateTime          @default(now())

  tutor User @relation("TutorInvites", fields: [tutorId], references: [id], onDelete: Cascade)

  @@index([tutorId])
  @@index([token])
  @@index([email])
}

model ApiLog {
  id           String   @id @default(cuid())
  method       String
  path         String
  statusCode   Int
  userId       String?
  userRole     String?
  userEmail    String?
  ip           String?
  userAgent    String?
  durationMs   Int
  errorMessage String?
  createdAt    DateTime @default(now())

  @@index([path])
  @@index([statusCode])
  @@index([userId])
  @@index([createdAt])
  @@index([method, statusCode])
}

model LiveSessionResource {
  id        String   @id @default(cuid())
  sessionId String
  title     String
  fileUrl   String
  fileName  String
  fileSize  Int?
  mimeType  String?
  createdAt DateTime @default(now())

  session LiveSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@index([sessionId])
}

model QuizQuestion {
  id        String       @id @default(cuid())
  lessonId  String
  question  String
  imageUrl  String?      // optional image shown with the question
  type      QuestionType @default(MULTIPLE_CHOICE)
  order     Int

  lesson  Lesson              @relation(fields: [lessonId], references: [id], onDelete: Cascade)
  options QuizOption[]
  answers QuizAttemptAnswer[]

  @@index([lessonId])
}

model QuizOption {
  id         String  @id @default(cuid())
  questionId String
  text       String
  imageUrl   String? // optional image or video url for the option
  mediaType  String? // "image" | "video"
  isCorrect  Boolean @default(false)
  order      Int

  question QuizQuestion        @relation(fields: [questionId], references: [id], onDelete: Cascade)
  answers  QuizAttemptAnswer[]

  @@index([questionId])
}

model QuizAttempt {
  id        String   @id @default(cuid())
  lessonId  String
  userId    String
  score     Int
  passed    Boolean
  createdAt DateTime @default(now())

  lesson  Lesson              @relation(fields: [lessonId], references: [id], onDelete: Cascade)
  user    User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  answers QuizAttemptAnswer[]

  @@index([lessonId])
  @@index([userId])
}

model QuizAttemptAnswer {
  id         String  @id @default(cuid())
  attemptId  String
  questionId String
  optionId   String?
  isCorrect  Boolean

  attempt  QuizAttempt  @relation(fields: [attemptId], references: [id], onDelete: Cascade)
  question QuizQuestion @relation(fields: [questionId], references: [id])
  option   QuizOption?  @relation(fields: [optionId], references: [id])

  @@index([attemptId])
}
