generator client {
  provider = "prisma-client"
  output   = "../app/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  ADMIN
  SUPPORT
  TUTOR
  STUDENT
}

enum CourseStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

/// Who can find a published course. PRIVATE: only students staff or a tutor
/// put on it (directly or through a group). PUBLIC: any approved student can
/// find it in the catalogue and enrol themselves.
enum CourseVisibility {
  PRIVATE
  PUBLIC
}

/// How a course is taught. ONLINE: classes happen in the platform's online
/// classroom. IN_PERSON: classes happen face to face at a venue — the course
/// still has its lessons and tests online, but its classes have no Join button.
enum CourseFormat {
  ONLINE
  IN_PERSON
}

enum CourseLevel {
  L1
  L2
  L3
  L4
  L5
  L6
}

enum LessonType {
  VIDEO
  TEXT
  QUIZ
}

// What a test (a lesson of type QUIZ) asks of the student.
enum TestKind {
  STANDARD // questions, each with or without a video
  STORY // one signed story, then questions about it
  FINGERSPELLING // watch a word being spelled and type it, against the clock
  VOCABULARY // watch a sign and pick its word, and/or read a word and sign it
  // A signed story in parts, as on the old assessment DVDs: for each part the
  // student watches its questions, then the part, then films their answers.
  ASSESSMENT
  // The student films a presentation on a set task, in one go, and sends it to
  // their teacher, who marks it and can record feedback over it.
  PRESENTATION
}

// How a vocabulary test is practised: from the sign to the word, from the word
// to the sign, or both ways round.
enum VocabularyMode {
  PICK_WORD // watch the sign, pick its word against the clock
  SIGN_IT // read the word, film yourself signing it, mark it against the sign
  BOTH // sign each word first, then watch the signs and pick the words
}

enum QuestionType {
  MULTIPLE_CHOICE
  TRUE_FALSE
  // The student types a sentence or two; after submitting they see the model
  // answer and give themselves 0-3 marks.
  WRITTEN
  // The student films themselves signing; after submitting the sign's video
  // plays next to theirs and they give themselves a tick or a cross. No longer
  // offered for new questions — vocabulary tests do this now (VocabularyMode)
  // — but the questions made before still work.
  SIGN
}

enum AssetType {
  VIDEO
  PDF
  IMAGE
  DOCUMENT
  AUDIO
  SUBTITLE
}

enum LiveSessionStatus {
  SCHEDULED
  LIVE
  COMPLETED
  CANCELLED
}

enum LiveSessionVisibility {
  PUBLIC
  INVITE_ONLY
}

enum JoinRequestStatus {
  PENDING
  APPROVED
  REJECTED
}

enum NotificationType {
  // Session events
  SESSION_SCHEDULED
  SESSION_STARTED
  SESSION_CANCELLED
  SESSION_DELETED
  SESSION_INVITE
  SESSION_COTUTOR_INVITE
  RECORDING_READY
  // Course / lesson events
  COURSE_PUBLISHED
  NEW_LESSON
  // Student activity (for tutors)
  NEW_ENROLLMENT
  NEW_REVIEW
  // Quiz results (for students)
  QUIZ_PASSED
  QUIZ_FAILED
  // An assessment a teacher marks has been sent in (for the course's teachers)
  TEST_TO_MARK
  // Messaging
  NEW_MESSAGE
  // Session join requests
  SESSION_JOIN_REQUEST
  SESSION_REQUEST_APPROVED
  SESSION_REQUEST_REJECTED
  // Certification events
  CERT_STEP_REVIEWED
  CERT_COMPLETED
  CERT_SUBMISSION_RECEIVED
  // Tutor review
  NEW_TUTOR_REVIEW
  // Staff / teacher nudging a student who is behind on lessons or tests (also
  // sent automatically once a week while a student stays behind)
  HOMEWORK_REMINDER
  // Automatic: a class the student is in is tomorrow / starts within the hour
  SESSION_REMINDER
  // Automatic: lessons held back for a release date have just opened
  LESSONS_UNLOCKED
  // A student's recordings in a course's tests are about to be deleted (the
  // course ended, or they left it) — download them now
  TEST_VIDEOS_EXPIRING
  // A tutor was put on a course as one of its teachers
  COURSE_TEACHER_ADDED
  // Sign-up approval: staff hear about a new account to review, and the
  // student hears how it went
  ACCOUNT_PENDING_APPROVAL
  ACCOUNT_APPROVED
  ACCOUNT_REJECTED
  // A recording's background replacement finished or failed (for whoever recorded it)
  VIDEO_BACKGROUND_READY
  VIDEO_BACKGROUND_FAILED
  // Ticket / feedback events
  TICKET_CREATED
  TICKET_UPDATED
  TICKET_RESOLVED
  TICKET_COMMENT
}

enum TicketType {
  BUG
  FEATURE
  SUGGESTION
  OTHER
}

enum TicketStatus {
  OPEN
  IN_PROGRESS
  RESOLVED
  CLOSED
}

enum TicketPriority {
  LOW
  MEDIUM
  HIGH
  URGENT
}

model User {
  id           String       @id @default(cuid())
  email        String       @unique
  passwordHash String? // null for OAuth-only users
  googleId     String?      @unique
  name         String
  role         Role         @default(STUDENT)
  avatarUrl    String?
  bslLevel     CourseLevel? // relevant for STUDENT role
  // Students may be signed in on one device at a time: the newest login's id
  // lives here and any older token carrying a different id is rejected.
  activeSessionId String?
  // Students who sign up on their own wait here until staff approve them (see
  // lib/account-approval.ts). Everyone else, and every account that existed
  // before approval, is ACTIVE.
  status       AccountStatus @default(ACTIVE)
  // What the student told us at sign-up ("which course or teacher?") so staff
  // can tell a real student from a stranger.
  signupNote   String?
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt

  tutorProfile         TutorProfile?
  courses              Course[]                @relation("TutorCourses")
  teachingCourses      CourseTutor[]           @relation("CourseTeaching")
  quizAttempts         QuizAttempt[]
  testsCreated         Test[]                  @relation("TestsCreated")
  leaguesCreated       League[]                @relation("LeaguesCreated")
  leagueMemberships    LeagueMember[]
  leagueAttempts       LeagueAttempt[]
  hostedSessions       LiveSession[]           @relation("TutorLiveSessions")
  coTutorSessions      LiveSessionCoTutor[]    @relation("CoTutorSessions")
  coTutorInvitesSent   LiveSessionCoTutor[]    @relation("CoTutorInvitesSent")
  enrollments          Enrollment[]
  attendances          LiveSessionAttendance[]
  sessionInvites       LiveSessionInvite[]
  reviews              Review[]
  studentConversations Conversation[]          @relation("StudentConversations")
  tutorConversations   Conversation[]          @relation("TutorConversations")
  sentMessages         Message[]               @relation("SentMessages")
  notifications        Notification[]
  pushSubscriptions    PushSubscription[]
  studentGroups        StudentGroup[]          @relation("TutorStudentGroups")
  groupMemberships     StudentGroupMember[]
  sentInvites          TutorInvite[]           @relation("TutorInvites")
  invitedStudents      User[]                  @relation("InvitedByTutor")
  invitedBy            User?                   @relation("InvitedByTutor", fields: [invitedById], references: [id])
  invitedById          String?
  submittedTickets     Ticket[]                @relation("SubmittedTickets")
  assignedTickets      Ticket[]                @relation("AssignedTickets")
  ticketComments       TicketComment[]         @relation("TicketComments")
  givenTutorReviews    TutorReview[]           @relation("StudentTutorReviews")
  receivedTutorReviews TutorReview[]           @relation("TutorReceivedReviews")
  sessionJoinRequests  SessionJoinRequest[]
  certEnrollments      CertEnrollment[]
  certReviews          CertStepSubmission[]    @relation("CertReviewer")
  passwordResetTokens  PasswordResetToken[]
  liveSessionChatMessages LiveSessionChatMessage[] @relation("LiveSessionChatMessages")
  libraryFiles         LibraryFile[]           @relation("TutorLibraryFiles")
  preparedCaptions     PreparedCaption[]       @relation("TutorPreparedCaptions")
  videoCleanJobs       VideoCleanJob[]
  savedSigns           SavedSign[]
}

enum AccountStatus {
  PENDING
  ACTIVE
  REJECTED
}

/// One row per automatic reminder already sent (see lib/reminders.ts), keyed by
/// what it was about — e.g. "class-day:<sessionId>:<studentId>" — so a reminder
/// run that overlaps or repeats never sends the same reminder twice.
model ReminderSent {
  key       String   @id
  createdAt DateTime @default(now())

  @@index([createdAt])
}

/// Platform-wide switches an admin changes from Settings. One row, id "default".
model PlatformSettings {
  id                      String   @id @default("default")
  studentApprovalRequired Boolean  @default(true)
  updatedAt               DateTime @updatedAt
}

model PasswordResetToken {
  id        String    @id @default(cuid())
  userId    String
  token     String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([token])
  @@index([expiresAt])
}

// A browser/phone that agreed to receive web push for this user. One row per
// device; rows the push service reports as gone (404/410) are deleted on send.
model PushSubscription {
  id        String   @id @default(cuid())
  userId    String
  endpoint  String   @unique
  p256dh    String
  auth      String
  userAgent String?
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model Notification {
  id        String           @id @default(cuid())
  userId    String
  type      NotificationType
  title     String
  body      String
  link      String?
  isRead    Boolean          @default(false)
  createdAt DateTime         @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([userId, isRead])
  @@index([createdAt])
}

enum VideoCleanStatus {
  PROCESSING
  DONE
  FAILED
}

// One per recording sent to have its background replaced after upload (see
// lib/background-clean.ts). Keyed by the raw upload rather than tied to a
// lesson or sign, because the recording is uploaded — and the job started —
// before whatever it belongs to has been saved.
model VideoCleanJob {
  id          String           @id @default(cuid())
  // S3 key of the raw upload: videos/{userId}/{uuid}/{name}.raw.webm
  rawKey      String           @unique
  userId      String
  color       String
  runpodJobId String?
  status      VideoCleanStatus @default(PROCESSING)
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([status])
}

model TutorProfile {
  id             String   @id @default(cuid())
  userId         String   @unique
  bio            String?
  qualifications String[] // e.g. ["CACDP Level 3", "Signature BSL"]
  isVerified     Boolean  @default(false)
  // What an admin lets this teacher change (see lib/tutor-access.ts). Off means
  // view only; downloads off means watch only. Everything starts off.
  canEditTests    Boolean @default(false)
  canEditCalendar Boolean @default(false)
  canEditLibrary  Boolean @default(false)
  canEditGroups   Boolean @default(false)
  canEditStudents Boolean @default(false)
  canDownload     Boolean @default(false)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Category {
  id      String   @id @default(cuid())
  name    String   @unique
  slug    String   @unique
  courses Course[]
}

model Sign {
  id          String      @id @default(cuid())
  word        String      @unique
  category    String
  level       CourseLevel @default(L1)
  description String
  videoUrl    String?
  imageUrl    String?
  handshape   String
  usage       String
  // Untick to keep a detail off the student dictionary (admins and tutors still see it).
  showLevel     Boolean   @default(true)
  showHandshape Boolean   @default(true)
  showUsage     Boolean   @default(true)
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt

  savedBy     SavedSign[]

  @@index([category])
  @@index([level])
}

// A sign a student starred in the dictionary — their own list to practise from.
model SavedSign {
  userId    String
  signId    String
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  sign Sign @relation(fields: [signId], references: [id], onDelete: Cascade)

  @@id([userId, signId])
  @@index([signId])
}

model Course {
  id           String       @id @default(cuid())
  tutorId      String
  categoryId   String?
  title        String
  slug         String       @unique
  description  String
  thumbnailUrl String?
  status       CourseStatus @default(DRAFT)
  visibility   CourseVisibility @default(PRIVATE)
  level        CourseLevel  @default(L1)
  format       CourseFormat @default(ONLINE)
  // Where a face-to-face course meets — the address students are shown.
  venue        String?
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt

  tutor        User          @relation("TutorCourses", fields: [tutorId], references: [id])
  category     Category?     @relation(fields: [categoryId], references: [id])
  teachers     CourseTutor[]
  groups       CourseGroup[]
  sections     Section[]
  enrollments  Enrollment[]
  liveSessions LiveSession[]
  reviews      Review[]

  @@index([tutorId])
  @@index([status])
}

// Teachers who take classes on a course without owning it. Admins build the
// course (one per level) and put teachers on it: a teacher sees the course, its
// lessons and its students, and schedules classes for it, but cannot change the
// content. `Course.tutorId` stays the lead and has the same view on its own.
model CourseTutor {
  courseId   String
  tutorId    String
  assignedAt DateTime @default(now())

  course Course @relation(fields: [courseId], references: [id], onDelete: Cascade)
  tutor  User   @relation("CourseTeaching", fields: [tutorId], references: [id], onDelete: Cascade)

  @@id([courseId, tutorId])
  @@index([tutorId])
}

// The student groups taking a course. A course is one level; each group on it
// is one class — its own students, its own day and time. Putting a group on a
// course enrols its members, and from then on a student added to the group
// joins the course and that group's upcoming classes with it.
model CourseGroup {
  courseId String
  groupId  String
  addedAt  DateTime @default(now())

  course Course       @relation(fields: [courseId], references: [id], onDelete: Cascade)
  group  StudentGroup @relation(fields: [groupId], references: [id], onDelete: Cascade)

  @@id([courseId, groupId])
  @@index([groupId])
}

model Section {
  id       String @id @default(cuid())
  courseId String
  title    String
  order    Int

  course  Course   @relation(fields: [courseId], references: [id], onDelete: Cascade)
  lessons Lesson[]

  @@index([courseId])
}

model Lesson {
  id          String     @id @default(cuid())
  sectionId   String
  title       String
  type        LessonType @default(VIDEO)
  description String?
  order       Int
  isFree      Boolean    @default(false)
  // When set, students see the lesson (or test) as locked, with this date,
  // and cannot open it until then — so a whole term can be prepared in advance
  // and released week by week. Null = available straight away. Staff and
  // teachers always see it.
  releaseAt   DateTime?
  // Tests only (type QUIZ): the test from the test bank this lesson puts in the
  // course. The questions and how it is passed live on the test, so one test
  // can sit in several courses; the attempts are kept here, per course.
  testId      String?

  section   Section          @relation(fields: [sectionId], references: [id], onDelete: Cascade)
  test      Test?            @relation(fields: [testId], references: [id], onDelete: Cascade)
  assets    LessonAsset[]
  progress  LessonProgress[]
  attempts  QuizAttempt[]

  @@index([sectionId])
  @@index([testId])
}

model LessonAsset {
  id          String    @id @default(cuid())
  lessonId    String
  type        AssetType
  title       String
  description String?
  fileUrl     String
  fileName    String
  fileSize    Int?
  duration    Int?
  mimeType    String?
  order       Int       @default(0)
  createdAt   DateTime  @default(now())

  lesson Lesson @relation(fields: [lessonId], references: [id], onDelete: Cascade)

  @@index([lessonId])
}

model Enrollment {
  id          String    @id @default(cuid())
  studentId   String
  courseId    String
  enrolledAt  DateTime  @default(now())
  completedAt DateTime?

  student  User             @relation(fields: [studentId], references: [id])
  course   Course           @relation(fields: [courseId], references: [id])
  progress LessonProgress[]

  @@unique([studentId, courseId])
  @@index([courseId])
  @@index([studentId])
}

model LessonProgress {
  id           String    @id @default(cuid())
  enrollmentId String
  lessonId     String
  isCompleted  Boolean   @default(false)
  watchedSecs  Int       @default(0)
  completedAt  DateTime?
  updatedAt    DateTime  @updatedAt

  enrollment Enrollment @relation(fields: [enrollmentId], references: [id], onDelete: Cascade)
  lesson     Lesson     @relation(fields: [lessonId], references: [id], onDelete: Cascade)

  @@unique([enrollmentId, lessonId])
}

model LiveSession {
  id           String                @id @default(cuid())
  tutorId      String
  courseId     String?
  // The group this class is for, when it is one group's class rather than the
  // whole course's. Its members are invited; this is what lets the course page
  // show each group's timetable.
  groupId      String?
  title        String
  description  String?
  scheduledAt  DateTime
  durationMins Int
  roomName     String                @unique
  maxStudents  Int?
  status       LiveSessionStatus     @default(SCHEDULED)
  visibility   LiveSessionVisibility @default(PUBLIC)
  startedAt    DateTime?
  endedAt      DateTime?
  egressId     String?
  recordingKey String?
  recordingUrl String?
  // Kept from students (staff can still watch). Set on recordings made before
  // recordings left students out, which show students' faces and names.
  recordingHidden Boolean @default(false)
  // A face-to-face class: it happens at `venue`, not in the online classroom,
  // so nobody gets a classroom token for it. Copied from the course's format
  // when the class is scheduled, and kept in step when the course changes.
  inPerson     Boolean               @default(false)
  venue        String?
  createdAt    DateTime              @default(now())

  tutor        User                    @relation("TutorLiveSessions", fields: [tutorId], references: [id])
  course       Course?                 @relation(fields: [courseId], references: [id])
  group        StudentGroup?           @relation(fields: [groupId], references: [id], onDelete: SetNull)
  attendances  LiveSessionAttendance[]
  invites      LiveSessionInvite[]
  coTutors     LiveSessionCoTutor[]
  joinRequests SessionJoinRequest[]
  resources    LiveSessionResource[]
  whiteboard   WhiteboardDoc?
  chatMessages LiveSessionChatMessage[]
  presentation LiveSessionPresentation?

  @@index([tutorId])
  @@index([status])
  @@index([scheduledAt])
  @@index([visibility])
  @@index([groupId])
}

// What is on the classroom stage right now, as last published by the tutor.
// The LiveKit data channel only carries "from now on", so a student who joins
// late — or reloads while the tutor's own tab is still coming back up — has
// nobody to ask. This row is the durable answer: any participant can read it on
// mount and land on the current slide immediately.
model LiveSessionPresentation {
  sessionId     String   @id
  active        Boolean  @default(false)
  kind          String?  // "slides" | "video"
  url           String?
  page          Int      @default(1)
  totalPages    Int      @default(0)
  // 1-based page numbers the tutor is presenting, in order.
  selectedPages Json?
  // Video playback, sampled at `updatedAt`. Students seek from here on join and
  // are corrected by the tutor's periodic `video_state` broadcasts thereafter.
  videoPlaying  Boolean  @default(false)
  videoTime     Float    @default(0)
  updatedAt     DateTime @updatedAt

  session LiveSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
}

// Classroom live-chat history for a session. Messages are also broadcast over
// the LiveKit data channel for real-time delivery; this table is the durable
// source so refreshes and late joiners can hydrate the full conversation.
model LiveSessionChatMessage {
  id        String   @id // client-generated so live + persisted copies share an id
  sessionId String
  senderId  String?
  fromName  String
  text      String   @default("")
  type      String   // "text" | "reaction" | "system"
  // Optional file attachment (JSON: { fileUrl, fileName, fileSize, mimeType })
  attachment Json?
  // Set when the message was sent inside a breakout group, so history only
  // hydrates for that group (and teachers). Null = whole class. Breakout groups
  // live only in the room's client state, so the id is the client's group id
  // and the name is kept alongside for labelling after the groups are gone.
  breakoutGroupId   String?
  breakoutGroupName String?
  createdAt DateTime @default(now())

  session LiveSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  sender  User?       @relation("LiveSessionChatMessages", fields: [senderId], references: [id], onDelete: SetNull)

  @@index([sessionId, createdAt])
  @@index([senderId])
  @@index([sessionId, breakoutGroupId])
}

// Persisted tldraw whiteboard for a live session. One snapshot per session
// (tldraw store snapshot JSON) so the board survives reloads/session end and
// can be reopened later. The tutor is authoritative: it seeds the board from
// this row on open and autosaves changes; students receive live state over the
// LiveKit data channel rather than reading this directly.
model WhiteboardDoc {
  id        String      @id @default(cuid())
  sessionId String      @unique
  session   LiveSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  snapshot  Json
  createdAt DateTime    @default(now())
  updatedAt DateTime    @updatedAt
}

model LiveSessionInvite {
  id        String   @id @default(cuid())
  sessionId String
  studentId String
  invitedAt DateTime @default(now())

  session LiveSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  student User        @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@unique([sessionId, studentId])
  @@index([studentId])
}

model LiveSessionCoTutor {
  id          String   @id @default(cuid())
  sessionId   String
  tutorId     String
  invitedById String
  invitedAt   DateTime @default(now())

  session     LiveSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  tutor       User        @relation("CoTutorSessions", fields: [tutorId], references: [id], onDelete: Cascade)
  invitedBy   User        @relation("CoTutorInvitesSent", fields: [invitedById], references: [id])

  @@unique([sessionId, tutorId])
  @@index([tutorId])
}

model LiveSessionAttendance {
  id        String    @id @default(cuid())
  sessionId String
  studentId String
  joinedAt  DateTime?
  leftAt    DateTime?

  session LiveSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  student User        @relation(fields: [studentId], references: [id])

  @@unique([sessionId, studentId])
  @@index([studentId])
}

model SessionJoinRequest {
  id              String            @id @default(cuid())
  sessionId       String
  studentId       String
  message         String?
  status          JoinRequestStatus @default(PENDING)
  responseMessage String?
  createdAt       DateTime          @default(now())
  respondedAt     DateTime?

  session LiveSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  student User        @relation(fields: [studentId], references: [id])

  @@unique([sessionId, studentId])
  @@index([sessionId])
  @@index([studentId])
}

model Review {
  id        String   @id @default(cuid())
  studentId String
  courseId  String
  rating    Int // 1–5
  comment   String?
  createdAt DateTime @default(now())

  student User   @relation(fields: [studentId], references: [id])
  course  Course @relation(fields: [courseId], references: [id])

  @@unique([studentId, courseId])
  @@index([courseId])
}

model TutorReview {
  id        String   @id @default(cuid())
  studentId String
  tutorId   String
  rating    Int // 1–5
  comment   String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  student User @relation("StudentTutorReviews", fields: [studentId], references: [id])
  tutor   User @relation("TutorReceivedReviews", fields: [tutorId], references: [id])

  @@unique([studentId, tutorId])
  @@index([tutorId])
}

model Conversation {
  id            String   @id @default(cuid())
  studentId     String
  tutorId       String
  lastMessageAt DateTime @default(now())
  createdAt     DateTime @default(now())

  student  User      @relation("StudentConversations", fields: [studentId], references: [id])
  tutor    User      @relation("TutorConversations", fields: [tutorId], references: [id])
  messages Message[]

  @@unique([studentId, tutorId])
  @@index([studentId])
  @@index([tutorId])
}

model Message {
  id             String   @id @default(cuid())
  conversationId String
  senderId       String
  content        String
  isRead         Boolean  @default(false)
  createdAt      DateTime @default(now())

  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  sender       User         @relation("SentMessages", fields: [senderId], references: [id])

  @@index([conversationId])
  @@index([senderId])
}

model StudentGroup {
  id        String   @id @default(cuid())
  tutorId   String
  name      String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  tutor    User                 @relation("TutorStudentGroups", fields: [tutorId], references: [id], onDelete: Cascade)
  members  StudentGroupMember[]
  courses  CourseGroup[]
  sessions LiveSession[]

  @@index([tutorId])
}

model StudentGroupMember {
  groupId   String
  studentId String
  addedAt   DateTime @default(now())

  group   StudentGroup @relation(fields: [groupId], references: [id], onDelete: Cascade)
  student User         @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@id([groupId, studentId])
  @@index([studentId])
}

enum TutorInviteStatus {
  PENDING
  ACCEPTED
  EXPIRED
}

model TutorInvite {
  id        String            @id @default(cuid())
  tutorId   String
  email     String
  token     String            @unique @default(cuid())
  status    TutorInviteStatus @default(PENDING)
  expiresAt DateTime
  createdAt DateTime          @default(now())

  tutor User @relation("TutorInvites", fields: [tutorId], references: [id], onDelete: Cascade)

  @@index([tutorId])
  @@index([token])
  @@index([email])
}

model ApiLog {
  id           String   @id @default(cuid())
  method       String
  path         String
  statusCode   Int
  userId       String?
  userRole     String?
  userEmail    String?
  ip           String?
  userAgent    String?
  durationMs   Int
  errorMessage String?
  createdAt    DateTime @default(now())

  @@index([path])
  @@index([statusCode])
  @@index([userId])
  @@index([createdAt])
  @@index([method, statusCode])
}

// The resource library: files uploaded once, ahead of time, and then picked
// into lessons and live sessions instead of being uploaded again each time.
// Picking copies the file reference into LessonAsset / LiveSessionResource, so
// removing a file from the library never breaks a lesson already using it.
//
// The school's library is the files owned by admins — every teacher can pick
// from those. `tutorId` is simply who uploaded the file; files a tutor added
// before the library was shared stay theirs alone.
model LibraryFile {
  id                   String    @id @default(cuid())
  tutorId              String
  title                String
  fileUrl              String
  fileName             String
  fileSize             Int?
  mimeType             String?
  assetType            AssetType
  presentationUrl      String?   // pre-converted PDF (PowerPoint uploads only)
  presentationMimeType String?
  // Which level the file is for, so a term's material can be filed in advance
  // and found by level. Null = not level-specific.
  level                CourseLevel?
  createdAt            DateTime  @default(now())

  tutor User @relation("TutorLibraryFiles", fields: [tutorId], references: [id], onDelete: Cascade)

  @@unique([tutorId, fileUrl])
  @@index([tutorId, createdAt])
}

// Captions a tutor writes ahead of time in their library and sends into the
// live classroom with one click, instead of typing them mid-lesson.
model PreparedCaption {
  id        String   @id @default(cuid())
  tutorId   String
  text      String
  order     Int
  createdAt DateTime @default(now())

  tutor User @relation("TutorPreparedCaptions", fields: [tutorId], references: [id], onDelete: Cascade)

  @@index([tutorId, order])
}

model LiveSessionResource {
  id                   String   @id @default(cuid())
  sessionId            String
  title                String
  fileUrl              String   // original file — used for student downloads
  fileName             String
  fileSize             Int?
  mimeType             String?
  presentationUrl      String?  // pre-converted PDF for low-latency classroom use
  presentationMimeType String?
  // Slides the tutor picked, in presentation order (1-based page numbers).
  // Set when a deck is prepared before class so the classroom can start
  // presenting the right subset without asking the tutor to choose again.
  selectedPages        Json?
  totalPages           Int?
  createdAt            DateTime @default(now())

  session LiveSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@index([sessionId])
}

// A test in the test bank (the Tests menu). It is made once and put in any
// number of courses: each placement is a lesson of type QUIZ pointing at it.
model Test {
  id            String       @id @default(cuid())
  title         String
  description   String?
  // The level it is for, so tests can be found by level. Null = any level.
  level         CourseLevel?
  testKind      TestKind     @default(STANDARD)
  // STORY: the video the questions are about.
  storyUrl      String?
  // STORY: whether students may pause, rewind and skip the story video. Off:
  // it just plays through, as on the old platform's assessments.
  storyControls Boolean      @default(false)
  // FINGERSPELLING / VOCABULARY: seconds a student has for each sign. In these
  // tests a question is just a video and its word (QuizQuestion.question), with
  // no options.
  answerSeconds Int?
  // FINGERSPELLING / VOCABULARY: how many times each sign's video plays — 1 or
  // 2 for a harder test, null to keep it repeating until the time is up.
  signPlays     Int?
  // VOCABULARY: which way round it is practised.
  vocabularyMode VocabularyMode @default(PICK_WORD)
  // ASSESSMENT: minutes a student has to film their answers to each part.
  answerMinutes Int?
  // ASSESSMENT: a teacher marks the filmed answers, instead of the student
  // marking them against the answer sheet.
  tutorMarks    Boolean      @default(false)
  // The score, out of 100, a student needs to pass, and how many times they may
  // sit it. Null attempts = as often as they like.
  passMark      Int          @default(70)
  maxAttempts   Int?
  // Who made it: a tutor changes their own tests, an admin any. The test stays
  // when the account goes, so the courses using it keep it.
  createdById   String?
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt

  createdBy User?          @relation("TestsCreated", fields: [createdById], references: [id], onDelete: SetNull)
  questions QuizQuestion[]
  lessons   Lesson[]
  leagues   League[]

  @@index([createdById])
  @@index([level])
}

model QuizQuestion {
  id       String       @id @default(cuid())
  testId   String
  question String
  imageUrl String? // optional image or video shown with the question
  mediaType String? // "image" | "video"
  // Whether students may pause, rewind and scrub this question's videos (its
  // own and its answers') while sitting the test. Off: they just play, looping.
  videoControls Boolean @default(false)
  // The question and its answers stay hidden until the question's video has
  // played to the end — watch first, then answer (the old platform's "After
  // watching video show question and answers").
  questionAfterVideo Boolean @default(false)
  type     QuestionType @default(MULTIPLE_CHOICE)
  // WRITTEN: the answer students compare theirs with once they have submitted.
  modelAnswer   String?
  // WRITTEN: what the question is worth; students see "(2 marks)" after it and
  // give themselves 0 up to this. Null = 3, as before it could be chosen.
  maxMarks      Int?
  // SIGN: the video of the sign done right, shown next to the student's own
  // recording once they have submitted — never before.
  answerVideoUrl String?
  // ASSESSMENT: a part's questions, signed — watched before the part itself
  // (imageUrl). The answer sheet is modelAnswer, its marks maxMarks.
  questionsVideoUrl String?
  // PRESENTATION: a file that goes with the task — a PDF, a picture, a Word
  // document or PowerPoint — for students to open before they present.
  attachmentUrl String?
  order    Int

  test    Test                @relation(fields: [testId], references: [id], onDelete: Cascade)
  options QuizOption[]
  answers QuizAttemptAnswer[]

  @@index([testId])
}

model QuizOption {
  id         String  @id @default(cuid())
  questionId String
  text       String
  imageUrl   String? // optional image or video url for the option
  mediaType  String? // "image" | "video"
  isCorrect  Boolean @default(false)
  order      Int

  question QuizQuestion        @relation(fields: [questionId], references: [id], onDelete: Cascade)
  answers  QuizAttemptAnswer[]

  @@index([questionId])
}

model QuizAttempt {
  id        String   @id @default(cuid())
  lessonId  String
  userId    String
  score     Int
  passed    Boolean
  // How long the go took, as timed by the student's device — splits a tie on
  // the high scores of a timed test.
  durationMs Int?
  // False while written or signed answers are still waiting for the student to
  // mark them; the score then counts them as 0 and the attempt cannot pass.
  selfMarked Boolean @default(true)
  createdAt DateTime @default(now())

  lesson  Lesson              @relation(fields: [lessonId], references: [id], onDelete: Cascade)
  user    User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  answers QuizAttemptAnswer[]

  @@index([lessonId])
  @@index([userId])
}

/// A student's recordings in a course's tests, waiting to be deleted: the
/// course was archived or they left it. They get a week to download them
/// (lib/test-recordings.ts); coming back to the course, or the course being
/// brought back, cancels it.
model TestVideoDeletion {
  id         String    @id @default(cuid())
  userId     String
  courseId   String
  deleteAt   DateTime
  // The day-before reminder went out.
  remindedAt DateTime?
  createdAt  DateTime  @default(now())

  @@unique([userId, courseId])
  @@index([deleteAt])
}

model QuizAttemptAnswer {
  id         String  @id @default(cuid())
  attemptId  String
  questionId String
  optionId   String?
  // Every option ticked, for a question with more than one correct answer.
  // optionId is then the first of them; a single-answer question leaves this empty.
  optionIds  String[] @default([])
  // Fingerspelling / vocabulary: the word the student typed or picked.
  // WRITTEN: what the student wrote.
  // A vocabulary test signed one way or both ways keeps the student's
  // recording in videoUrl and their tick or cross in marks; isCorrect is then
  // only the word picked.
  answerText String?
  // SIGN (and vocabulary signed): the student's recording of themselves. Deleted a week after the
  // course is archived or the student leaves it (lib/test-recordings.ts), when
  // this goes back to null.
  videoUrl   String?
  // WRITTEN / SIGN: the marks given — by the student, or by a teacher who
  // changed them. Null until the student has marked the question.
  marks      Int?
  markedByTutor Boolean @default(false)
  // A filmed answer a teacher marks: the teacher's feedback, recorded as they
  // share their screen with the student's video on it. Kept with the
  // student's recordings (lib/test-recordings.ts) and deleted with them.
  feedbackVideoUrl String?
  isCorrect  Boolean

  attempt  QuizAttempt  @relation(fields: [attemptId], references: [id], onDelete: Cascade)
  // Cascade, so a question (or the whole test) can be deleted once students
  // have sat it. The attempt keeps the score it was given.
  question QuizQuestion @relation(fields: [questionId], references: [id], onDelete: Cascade)
  option   QuizOption?  @relation(fields: [optionId], references: [id])

  @@index([attemptId])
}

/// How hard a fingerspelling league is played (lib/leagues.ts): the time for
/// each word and how often it is shown.
enum LeagueDifficulty {
  EASY
  MEDIUM
  HARD
}

// A fingerspelling league: a competition any student can choose to join,
// whatever their level or courses. Its words are a fingerspelling test from the
// test bank; its difficulty sets the clock. Each member's best go ranks them.
model League {
  id          String           @id @default(cuid())
  title       String
  difficulty  LeagueDifficulty
  // The words. Null when that test has been deleted — the table stays, but
  // nobody can play until a teacher picks new words.
  testId      String?
  // After this the table is final and no more goes count. Null = it runs on.
  endsAt      DateTime?
  createdById String?
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt

  test      Test?           @relation(fields: [testId], references: [id], onDelete: SetNull)
  createdBy User?           @relation("LeaguesCreated", fields: [createdById], references: [id], onDelete: SetNull)
  members   LeagueMember[]
  attempts  LeagueAttempt[]

  @@index([testId])
}

model LeagueMember {
  id       String   @id @default(cuid())
  leagueId String
  userId   String
  joinedAt DateTime @default(now())

  league League @relation(fields: [leagueId], references: [id], onDelete: Cascade)
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([leagueId, userId])
  @@index([userId])
}

// One go at a league. Kept apart from course tests: it never counts towards
// passing a course.
model LeagueAttempt {
  id         String   @id @default(cuid())
  leagueId   String
  userId     String
  correct    Int
  total      Int
  // correct out of total, as a whole percent.
  score      Int
  // As timed by the student's device — splits a tie.
  durationMs Int?
  createdAt  DateTime @default(now())

  league League @relation(fields: [leagueId], references: [id], onDelete: Cascade)
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([leagueId, userId])
}

model Ticket {
  id           String         @id @default(cuid())
  submitterId  String
  title        String
  description  String
  type         TicketType     @default(OTHER)
  priority     TicketPriority @default(MEDIUM)
  status       TicketStatus   @default(OPEN)
  assignedToId String?
  resolvedAt   DateTime?
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt

  submitter   User               @relation("SubmittedTickets", fields: [submitterId], references: [id], onDelete: Cascade)
  assignedTo  User?              @relation("AssignedTickets", fields: [assignedToId], references: [id])
  attachments TicketAttachment[]
  comments    TicketComment[]

  @@index([status])
  @@index([submitterId])
  @@index([assignedToId])
  @@index([createdAt])
}

model TicketAttachment {
  id        String   @id @default(cuid())
  ticketId  String
  fileUrl   String
  fileName  String
  fileSize  Int?
  mimeType  String?
  createdAt DateTime @default(now())

  ticket Ticket @relation(fields: [ticketId], references: [id], onDelete: Cascade)

  @@index([ticketId])
}

model TicketComment {
  id        String   @id @default(cuid())
  ticketId  String
  authorId  String
  content   String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  ticket Ticket @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  author User   @relation("TicketComments", fields: [authorId], references: [id])

  @@index([ticketId])
  @@index([authorId])
}

// ─── Certification System ─────────────────────────────────────────────────────

enum CertProgramStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

enum CertStepType {
  COURSE_COMPLETION
  QUIZ
  VIDEO_SUBMISSION
  LIVE_ASSESSMENT
}

enum CertSubmissionStatus {
  NOT_STARTED
  PENDING // submitted, awaiting review
  UNDER_REVIEW // reviewer is looking at it
  PASSED
  FAILED
}

enum CertEnrollmentStatus {
  ACTIVE
  COMPLETED
  CANCELLED
}

model CertProgram {
  id             String            @id @default(cuid())
  title          String
  description    String?
  level          CourseLevel       @default(L1)
  status         CertProgramStatus @default(DRAFT)
  price          Int               @default(0) // in pence (0 = free)
  imageUrl       String?
  validityMonths Int? // null = never expires
  createdAt      DateTime          @default(now())
  updatedAt      DateTime          @updatedAt

  steps       CertStep[]
  enrollments CertEnrollment[]

  @@index([status])
}

model CertStep {
  id          String       @id @default(cuid())
  programId   String
  title       String
  description String?
  type        CertStepType
  sortOrder   Int          @default(0)

  // Type-specific config (JSON — keeps schema flexible for admin customisation)
  // COURSE_COMPLETION: { "courseId": "..." }
  // QUIZ:              { "passScore": 80, "questions": [...] }
  // VIDEO_SUBMISSION:  { "prompt": "Record yourself signing...", "maxDurationSecs": 120 }
  // LIVE_ASSESSMENT:   { "instructions": "You will be assessed on...", "durationMins": 30 }
  config Json @default("{}")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  program     CertProgram          @relation(fields: [programId], references: [id], onDelete: Cascade)
  submissions CertStepSubmission[]

  @@index([programId])
}

model CertEnrollment {
  id          String               @id @default(cuid())
  studentId   String
  programId   String
  status      CertEnrollmentStatus @default(ACTIVE)
  enrolledAt  DateTime             @default(now())
  completedAt DateTime?

  student     User                 @relation(fields: [studentId], references: [id])
  program     CertProgram          @relation(fields: [programId], references: [id])
  submissions CertStepSubmission[]
  certificate Certificate?

  @@unique([studentId, programId])
  @@index([studentId])
  @@index([programId])
}

model CertStepSubmission {
  id           String               @id @default(cuid())
  enrollmentId String
  stepId       String
  status       CertSubmissionStatus @default(NOT_STARTED)

  // Submission data (varies by step type)
  // QUIZ:             { "attemptId": "...", "score": 85 }
  // VIDEO_SUBMISSION: { "videoUrl": "...", "fileName": "..." }
  // LIVE_ASSESSMENT:  { "sessionDate": "...", "assessorId": "..." }
  data Json @default("{}")

  // Review fields (for VIDEO_SUBMISSION and LIVE_ASSESSMENT)
  reviewerId String?
  reviewNote String?
  reviewedAt DateTime?

  submittedAt DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  enrollment CertEnrollment @relation(fields: [enrollmentId], references: [id], onDelete: Cascade)
  step       CertStep       @relation(fields: [stepId], references: [id], onDelete: Cascade)
  reviewer   User?          @relation("CertReviewer", fields: [reviewerId], references: [id])

  @@unique([enrollmentId, stepId])
  @@index([enrollmentId])
  @@index([stepId])
}

model Certificate {
  id           String    @id @default(cuid())
  enrollmentId String    @unique
  token        String    @unique @default(cuid()) // public verification token
  studentName  String // snapshot at issue time
  programTitle String // snapshot at issue time
  level        String
  issuedAt     DateTime  @default(now())
  expiresAt    DateTime?

  enrollment CertEnrollment @relation(fields: [enrollmentId], references: [id], onDelete: Cascade)

  @@index([token])
}
