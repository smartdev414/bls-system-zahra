generator client {
  provider = "prisma-client"
  output   = "../app/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  ADMIN
  SUPPORT
  TUTOR
  STUDENT
}

enum CourseStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

enum CourseLevel {
  L1
  L2
  L3
  L4
  L5
  L6
}

enum LessonType {
  VIDEO
  TEXT
  QUIZ
}

enum QuestionType {
  MULTIPLE_CHOICE
  TRUE_FALSE
}

enum AssetType {
  VIDEO
  PDF
  IMAGE
  DOCUMENT
  AUDIO
  SUBTITLE
}

enum LiveSessionStatus {
  SCHEDULED
  LIVE
  COMPLETED
  CANCELLED
}

enum LiveSessionVisibility {
  PUBLIC
  INVITE_ONLY
}

enum JoinRequestStatus {
  PENDING
  APPROVED
  REJECTED
}

enum NotificationType {
  // Session events
  SESSION_SCHEDULED
  SESSION_STARTED
  SESSION_CANCELLED
  SESSION_DELETED
  SESSION_INVITE
  SESSION_COTUTOR_INVITE
  RECORDING_READY
  // Course / lesson events
  COURSE_PUBLISHED
  NEW_LESSON
  // Student activity (for tutors)
  NEW_ENROLLMENT
  NEW_REVIEW
  // Quiz results (for students)
  QUIZ_PASSED
  QUIZ_FAILED
  // Messaging
  NEW_MESSAGE
  // Session join requests
  SESSION_JOIN_REQUEST
  SESSION_REQUEST_APPROVED
  SESSION_REQUEST_REJECTED
  // Certification events
  CERT_STEP_REVIEWED
  CERT_COMPLETED
  CERT_SUBMISSION_RECEIVED
  // Tutor review
  NEW_TUTOR_REVIEW
  // Ticket / feedback events
  TICKET_CREATED
  TICKET_UPDATED
  TICKET_RESOLVED
  TICKET_COMMENT
}

enum TicketType {
  BUG
  FEATURE
  SUGGESTION
  OTHER
}

enum TicketStatus {
  OPEN
  IN_PROGRESS
  RESOLVED
  CLOSED
}

enum TicketPriority {
  LOW
  MEDIUM
  HIGH
  URGENT
}

model User {
  id           String       @id @default(cuid())
  email        String       @unique
  passwordHash String? // null for OAuth-only users
  googleId     String?      @unique
  name         String
  role         Role         @default(STUDENT)
  avatarUrl    String?
  bslLevel     CourseLevel? // relevant for STUDENT role
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt

  tutorProfile         TutorProfile?
  courses              Course[]                @relation("TutorCourses")
  quizAttempts         QuizAttempt[]
  hostedSessions       LiveSession[]           @relation("TutorLiveSessions")
  coTutorSessions      LiveSessionCoTutor[]    @relation("CoTutorSessions")
  coTutorInvitesSent   LiveSessionCoTutor[]    @relation("CoTutorInvitesSent")
  enrollments          Enrollment[]
  attendances          LiveSessionAttendance[]
  sessionInvites       LiveSessionInvite[]
  reviews              Review[]
  studentConversations Conversation[]          @relation("StudentConversations")
  tutorConversations   Conversation[]          @relation("TutorConversations")
  sentMessages         Message[]               @relation("SentMessages")
  notifications        Notification[]
  studentGroups        StudentGroup[]          @relation("TutorStudentGroups")
  groupMemberships     StudentGroupMember[]
  sentInvites          TutorInvite[]           @relation("TutorInvites")
  invitedStudents      User[]                  @relation("InvitedByTutor")
  invitedBy            User?                   @relation("InvitedByTutor", fields: [invitedById], references: [id])
  invitedById          String?
  submittedTickets     Ticket[]                @relation("SubmittedTickets")
  assignedTickets      Ticket[]                @relation("AssignedTickets")
  ticketComments       TicketComment[]         @relation("TicketComments")
  givenTutorReviews    TutorReview[]           @relation("StudentTutorReviews")
  receivedTutorReviews TutorReview[]           @relation("TutorReceivedReviews")
  sessionJoinRequests  SessionJoinRequest[]
  certEnrollments      CertEnrollment[]
  certReviews          CertStepSubmission[]    @relation("CertReviewer")
  passwordResetTokens  PasswordResetToken[]
  liveSessionChatMessages LiveSessionChatMessage[] @relation("LiveSessionChatMessages")
  libraryFiles         LibraryFile[]           @relation("TutorLibraryFiles")
  preparedCaptions     PreparedCaption[]       @relation("TutorPreparedCaptions")
}

model PasswordResetToken {
  id        String    @id @default(cuid())
  userId    String
  token     String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([token])
  @@index([expiresAt])
}

model Notification {
  id        String           @id @default(cuid())
  userId    String
  type      NotificationType
  title     String
  body      String
  link      String?
  isRead    Boolean          @default(false)
  createdAt DateTime         @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([userId, isRead])
  @@index([createdAt])
}

model TutorProfile {
  id             String   @id @default(cuid())
  userId         String   @unique
  bio            String?
  qualifications String[] // e.g. ["CACDP Level 3", "Signature BSL"]
  isVerified     Boolean  @default(false)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Category {
  id      String   @id @default(cuid())
  name    String   @unique
  slug    String   @unique
  courses Course[]
}

model Sign {
  id          String      @id @default(cuid())
  word        String      @unique
  category    String
  level       CourseLevel @default(L1)
  description String
  videoUrl    String?
  imageUrl    String?
  handshape   String
  usage       String
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt

  @@index([category])
  @@index([level])
}

model Course {
  id           String       @id @default(cuid())
  tutorId      String
  categoryId   String?
  title        String
  slug         String       @unique
  description  String
  thumbnailUrl String?
  status       CourseStatus @default(DRAFT)
  level        CourseLevel  @default(L1)
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt

  tutor        User          @relation("TutorCourses", fields: [tutorId], references: [id])
  category     Category?     @relation(fields: [categoryId], references: [id])
  sections     Section[]
  enrollments  Enrollment[]
  liveSessions LiveSession[]
  reviews      Review[]

  @@index([tutorId])
  @@index([status])
}

model Section {
  id       String @id @default(cuid())
  courseId String
  title    String
  order    Int

  course  Course   @relation(fields: [courseId], references: [id], onDelete: Cascade)
  lessons Lesson[]

  @@index([courseId])
}

model Lesson {
  id          String     @id @default(cuid())
  sectionId   String
  title       String
  type        LessonType @default(VIDEO)
  description String?
  order       Int
  isFree      Boolean    @default(false)

  section   Section          @relation(fields: [sectionId], references: [id], onDelete: Cascade)
  assets    LessonAsset[]
  progress  LessonProgress[]
  questions QuizQuestion[]
  attempts  QuizAttempt[]

  @@index([sectionId])
}

model LessonAsset {
  id          String    @id @default(cuid())
  lessonId    String
  type        AssetType
  title       String
  description String?
  fileUrl     String
  fileName    String
  fileSize    Int?
  duration    Int?
  mimeType    String?
  order       Int       @default(0)
  createdAt   DateTime  @default(now())

  lesson Lesson @relation(fields: [lessonId], references: [id], onDelete: Cascade)

  @@index([lessonId])
}

model Enrollment {
  id          String    @id @default(cuid())
  studentId   String
  courseId    String
  enrolledAt  DateTime  @default(now())
  completedAt DateTime?

  student  User             @relation(fields: [studentId], references: [id])
  course   Course           @relation(fields: [courseId], references: [id])
  progress LessonProgress[]

  @@unique([studentId, courseId])
  @@index([courseId])
  @@index([studentId])
}

model LessonProgress {
  id           String    @id @default(cuid())
  enrollmentId String
  lessonId     String
  isCompleted  Boolean   @default(false)
  watchedSecs  Int       @default(0)
  completedAt  DateTime?
  updatedAt    DateTime  @updatedAt

  enrollment Enrollment @relation(fields: [enrollmentId], references: [id], onDelete: Cascade)
  lesson     Lesson     @relation(fields: [lessonId], references: [id], onDelete: Cascade)

  @@unique([enrollmentId, lessonId])
}

model LiveSession {
  id           String                @id @default(cuid())
  tutorId      String
  courseId     String?
  title        String
  description  String?
  scheduledAt  DateTime
  durationMins Int
  roomName     String                @unique
  maxStudents  Int?
  status       LiveSessionStatus     @default(SCHEDULED)
  visibility   LiveSessionVisibility @default(PUBLIC)
  startedAt    DateTime?
  endedAt      DateTime?
  egressId     String?
  recordingKey String?
  recordingUrl String?
  createdAt    DateTime              @default(now())

  tutor        User                    @relation("TutorLiveSessions", fields: [tutorId], references: [id])
  course       Course?                 @relation(fields: [courseId], references: [id])
  attendances  LiveSessionAttendance[]
  invites      LiveSessionInvite[]
  coTutors     LiveSessionCoTutor[]
  joinRequests SessionJoinRequest[]
  resources    LiveSessionResource[]
  whiteboard   WhiteboardDoc?
  chatMessages LiveSessionChatMessage[]
  presentation LiveSessionPresentation?

  @@index([tutorId])
  @@index([status])
  @@index([scheduledAt])
  @@index([visibility])
}

// What is on the classroom stage right now, as last published by the tutor.
// The LiveKit data channel only carries "from now on", so a student who joins
// late — or reloads while the tutor's own tab is still coming back up — has
// nobody to ask. This row is the durable answer: any participant can read it on
// mount and land on the current slide immediately.
model LiveSessionPresentation {
  sessionId     String   @id
  active        Boolean  @default(false)
  kind          String?  // "slides" | "video"
  url           String?
  page          Int      @default(1)
  totalPages    Int      @default(0)
  // 1-based page numbers the tutor is presenting, in order.
  selectedPages Json?
  // Video playback, sampled at `updatedAt`. Students seek from here on join and
  // are corrected by the tutor's periodic `video_state` broadcasts thereafter.
  videoPlaying  Boolean  @default(false)
  videoTime     Float    @default(0)
  updatedAt     DateTime @updatedAt

  session LiveSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
}

// Classroom live-chat history for a session. Messages are also broadcast over
// the LiveKit data channel for real-time delivery; this table is the durable
// source so refreshes and late joiners can hydrate the full conversation.
model LiveSessionChatMessage {
  id        String   @id // client-generated so live + persisted copies share an id
  sessionId String
  senderId  String?
  fromName  String
  text      String   @default("")
  type      String   // "text" | "reaction" | "system"
  // Optional file attachment (JSON: { fileUrl, fileName, fileSize, mimeType })
  attachment Json?
  // Set when the message was sent inside a breakout group, so history only
  // hydrates for that group (and teachers). Null = whole class. Breakout groups
  // live only in the room's client state, so the id is the client's group id
  // and the name is kept alongside for labelling after the groups are gone.
  breakoutGroupId   String?
  breakoutGroupName String?
  createdAt DateTime @default(now())

  session LiveSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  sender  User?       @relation("LiveSessionChatMessages", fields: [senderId], references: [id], onDelete: SetNull)

  @@index([sessionId, createdAt])
  @@index([senderId])
  @@index([sessionId, breakoutGroupId])
}

// Persisted tldraw whiteboard for a live session. One snapshot per session
// (tldraw store snapshot JSON) so the board survives reloads/session end and
// can be reopened later. The tutor is authoritative: it seeds the board from
// this row on open and autosaves changes; students receive live state over the
// LiveKit data channel rather than reading this directly.
model WhiteboardDoc {
  id        String      @id @default(cuid())
  sessionId String      @unique
  session   LiveSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  snapshot  Json
  createdAt DateTime    @default(now())
  updatedAt DateTime    @updatedAt
}

model LiveSessionInvite {
  id        String   @id @default(cuid())
  sessionId String
  studentId String
  invitedAt DateTime @default(now())

  session LiveSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  student User        @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@unique([sessionId, studentId])
  @@index([studentId])
}

model LiveSessionCoTutor {
  id          String   @id @default(cuid())
  sessionId   String
  tutorId     String
  invitedById String
  invitedAt   DateTime @default(now())

  session     LiveSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  tutor       User        @relation("CoTutorSessions", fields: [tutorId], references: [id], onDelete: Cascade)
  invitedBy   User        @relation("CoTutorInvitesSent", fields: [invitedById], references: [id])

  @@unique([sessionId, tutorId])
  @@index([tutorId])
}

model LiveSessionAttendance {
  id        String    @id @default(cuid())
  sessionId String
  studentId String
  joinedAt  DateTime?
  leftAt    DateTime?

  session LiveSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  student User        @relation(fields: [studentId], references: [id])

  @@unique([sessionId, studentId])
  @@index([studentId])
}

model SessionJoinRequest {
  id              String            @id @default(cuid())
  sessionId       String
  studentId       String
  message         String?
  status          JoinRequestStatus @default(PENDING)
  responseMessage String?
  createdAt       DateTime          @default(now())
  respondedAt     DateTime?

  session LiveSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  student User        @relation(fields: [studentId], references: [id])

  @@unique([sessionId, studentId])
  @@index([sessionId])
  @@index([studentId])
}

model Review {
  id        String   @id @default(cuid())
  studentId String
  courseId  String
  rating    Int // 1–5
  comment   String?
  createdAt DateTime @default(now())

  student User   @relation(fields: [studentId], references: [id])
  course  Course @relation(fields: [courseId], references: [id])

  @@unique([studentId, courseId])
  @@index([courseId])
}

model TutorReview {
  id        String   @id @default(cuid())
  studentId String
  tutorId   String
  rating    Int // 1–5
  comment   String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  student User @relation("StudentTutorReviews", fields: [studentId], references: [id])
  tutor   User @relation("TutorReceivedReviews", fields: [tutorId], references: [id])

  @@unique([studentId, tutorId])
  @@index([tutorId])
}

model Conversation {
  id            String   @id @default(cuid())
  studentId     String
  tutorId       String
  lastMessageAt DateTime @default(now())
  createdAt     DateTime @default(now())

  student  User      @relation("StudentConversations", fields: [studentId], references: [id])
  tutor    User      @relation("TutorConversations", fields: [tutorId], references: [id])
  messages Message[]

  @@unique([studentId, tutorId])
  @@index([studentId])
  @@index([tutorId])
}

model Message {
  id             String   @id @default(cuid())
  conversationId String
  senderId       String
  content        String
  isRead         Boolean  @default(false)
  createdAt      DateTime @default(now())

  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  sender       User         @relation("SentMessages", fields: [senderId], references: [id])

  @@index([conversationId])
  @@index([senderId])
}

model StudentGroup {
  id        String   @id @default(cuid())
  tutorId   String
  name      String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  tutor   User                 @relation("TutorStudentGroups", fields: [tutorId], references: [id], onDelete: Cascade)
  members StudentGroupMember[]

  @@index([tutorId])
}

model StudentGroupMember {
  groupId   String
  studentId String
  addedAt   DateTime @default(now())

  group   StudentGroup @relation(fields: [groupId], references: [id], onDelete: Cascade)
  student User         @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@id([groupId, studentId])
  @@index([studentId])
}

enum TutorInviteStatus {
  PENDING
  ACCEPTED
  EXPIRED
}

model TutorInvite {
  id        String            @id @default(cuid())
  tutorId   String
  email     String
  token     String            @unique @default(cuid())
  status    TutorInviteStatus @default(PENDING)
  expiresAt DateTime
  createdAt DateTime          @default(now())

  tutor User @relation("TutorInvites", fields: [tutorId], references: [id], onDelete: Cascade)

  @@index([tutorId])
  @@index([token])
  @@index([email])
}

model ApiLog {
  id           String   @id @default(cuid())
  method       String
  path         String
  statusCode   Int
  userId       String?
  userRole     String?
  userEmail    String?
  ip           String?
  userAgent    String?
  durationMs   Int
  errorMessage String?
  createdAt    DateTime @default(now())

  @@index([path])
  @@index([statusCode])
  @@index([userId])
  @@index([createdAt])
  @@index([method, statusCode])
}

// A tutor's own resource library: files uploaded once, ahead of time, and then
// picked into lessons and live sessions instead of being uploaded again each
// time. Picking copies the file reference into LessonAsset / LiveSessionResource,
// so removing a file from the library never breaks a lesson already using it.
model LibraryFile {
  id                   String    @id @default(cuid())
  tutorId              String
  title                String
  fileUrl              String
  fileName             String
  fileSize             Int?
  mimeType             String?
  assetType            AssetType
  presentationUrl      String?   // pre-converted PDF (PowerPoint uploads only)
  presentationMimeType String?
  createdAt            DateTime  @default(now())

  tutor User @relation("TutorLibraryFiles", fields: [tutorId], references: [id], onDelete: Cascade)

  @@unique([tutorId, fileUrl])
  @@index([tutorId, createdAt])
}

// Captions a tutor writes ahead of time in their library and sends into the
// live classroom with one click, instead of typing them mid-lesson.
model PreparedCaption {
  id        String   @id @default(cuid())
  tutorId   String
  text      String
  order     Int
  createdAt DateTime @default(now())

  tutor User @relation("TutorPreparedCaptions", fields: [tutorId], references: [id], onDelete: Cascade)

  @@index([tutorId, order])
}

model LiveSessionResource {
  id                   String   @id @default(cuid())
  sessionId            String
  title                String
  fileUrl              String   // original file — used for student downloads
  fileName             String
  fileSize             Int?
  mimeType             String?
  presentationUrl      String?  // pre-converted PDF for low-latency classroom use
  presentationMimeType String?
  // Slides the tutor picked, in presentation order (1-based page numbers).
  // Set when a deck is prepared before class so the classroom can start
  // presenting the right subset without asking the tutor to choose again.
  selectedPages        Json?
  totalPages           Int?
  createdAt            DateTime @default(now())

  session LiveSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@index([sessionId])
}

model QuizQuestion {
  id       String       @id @default(cuid())
  lessonId String
  question String
  imageUrl String? // optional image shown with the question
  type     QuestionType @default(MULTIPLE_CHOICE)
  order    Int

  lesson  Lesson              @relation(fields: [lessonId], references: [id], onDelete: Cascade)
  options QuizOption[]
  answers QuizAttemptAnswer[]

  @@index([lessonId])
}

model QuizOption {
  id         String  @id @default(cuid())
  questionId String
  text       String
  imageUrl   String? // optional image or video url for the option
  mediaType  String? // "image" | "video"
  isCorrect  Boolean @default(false)
  order      Int

  question QuizQuestion        @relation(fields: [questionId], references: [id], onDelete: Cascade)
  answers  QuizAttemptAnswer[]

  @@index([questionId])
}

model QuizAttempt {
  id        String   @id @default(cuid())
  lessonId  String
  userId    String
  score     Int
  passed    Boolean
  createdAt DateTime @default(now())

  lesson  Lesson              @relation(fields: [lessonId], references: [id], onDelete: Cascade)
  user    User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  answers QuizAttemptAnswer[]

  @@index([lessonId])
  @@index([userId])
}

model QuizAttemptAnswer {
  id         String  @id @default(cuid())
  attemptId  String
  questionId String
  optionId   String?
  isCorrect  Boolean

  attempt  QuizAttempt  @relation(fields: [attemptId], references: [id], onDelete: Cascade)
  question QuizQuestion @relation(fields: [questionId], references: [id])
  option   QuizOption?  @relation(fields: [optionId], references: [id])

  @@index([attemptId])
}

model Ticket {
  id           String         @id @default(cuid())
  submitterId  String
  title        String
  description  String
  type         TicketType     @default(OTHER)
  priority     TicketPriority @default(MEDIUM)
  status       TicketStatus   @default(OPEN)
  assignedToId String?
  resolvedAt   DateTime?
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt

  submitter   User               @relation("SubmittedTickets", fields: [submitterId], references: [id], onDelete: Cascade)
  assignedTo  User?              @relation("AssignedTickets", fields: [assignedToId], references: [id])
  attachments TicketAttachment[]
  comments    TicketComment[]

  @@index([status])
  @@index([submitterId])
  @@index([assignedToId])
  @@index([createdAt])
}

model TicketAttachment {
  id        String   @id @default(cuid())
  ticketId  String
  fileUrl   String
  fileName  String
  fileSize  Int?
  mimeType  String?
  createdAt DateTime @default(now())

  ticket Ticket @relation(fields: [ticketId], references: [id], onDelete: Cascade)

  @@index([ticketId])
}

model TicketComment {
  id        String   @id @default(cuid())
  ticketId  String
  authorId  String
  content   String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  ticket Ticket @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  author User   @relation("TicketComments", fields: [authorId], references: [id])

  @@index([ticketId])
  @@index([authorId])
}

// ─── Certification System ─────────────────────────────────────────────────────

enum CertProgramStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

enum CertStepType {
  COURSE_COMPLETION
  QUIZ
  VIDEO_SUBMISSION
  LIVE_ASSESSMENT
}

enum CertSubmissionStatus {
  NOT_STARTED
  PENDING // submitted, awaiting review
  UNDER_REVIEW // reviewer is looking at it
  PASSED
  FAILED
}

enum CertEnrollmentStatus {
  ACTIVE
  COMPLETED
  CANCELLED
}

model CertProgram {
  id             String            @id @default(cuid())
  title          String
  description    String?
  level          CourseLevel       @default(L1)
  status         CertProgramStatus @default(DRAFT)
  price          Int               @default(0) // in pence (0 = free)
  imageUrl       String?
  validityMonths Int? // null = never expires
  createdAt      DateTime          @default(now())
  updatedAt      DateTime          @updatedAt

  steps       CertStep[]
  enrollments CertEnrollment[]

  @@index([status])
}

model CertStep {
  id          String       @id @default(cuid())
  programId   String
  title       String
  description String?
  type        CertStepType
  sortOrder   Int          @default(0)

  // Type-specific config (JSON — keeps schema flexible for admin customisation)
  // COURSE_COMPLETION: { "courseId": "..." }
  // QUIZ:              { "passScore": 80, "questions": [...] }
  // VIDEO_SUBMISSION:  { "prompt": "Record yourself signing...", "maxDurationSecs": 120 }
  // LIVE_ASSESSMENT:   { "instructions": "You will be assessed on...", "durationMins": 30 }
  config Json @default("{}")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  program     CertProgram          @relation(fields: [programId], references: [id], onDelete: Cascade)
  submissions CertStepSubmission[]

  @@index([programId])
}

model CertEnrollment {
  id          String               @id @default(cuid())
  studentId   String
  programId   String
  status      CertEnrollmentStatus @default(ACTIVE)
  enrolledAt  DateTime             @default(now())
  completedAt DateTime?

  student     User                 @relation(fields: [studentId], references: [id])
  program     CertProgram          @relation(fields: [programId], references: [id])
  submissions CertStepSubmission[]
  certificate Certificate?

  @@unique([studentId, programId])
  @@index([studentId])
  @@index([programId])
}

model CertStepSubmission {
  id           String               @id @default(cuid())
  enrollmentId String
  stepId       String
  status       CertSubmissionStatus @default(NOT_STARTED)

  // Submission data (varies by step type)
  // QUIZ:             { "attemptId": "...", "score": 85 }
  // VIDEO_SUBMISSION: { "videoUrl": "...", "fileName": "..." }
  // LIVE_ASSESSMENT:  { "sessionDate": "...", "assessorId": "..." }
  data Json @default("{}")

  // Review fields (for VIDEO_SUBMISSION and LIVE_ASSESSMENT)
  reviewerId String?
  reviewNote String?
  reviewedAt DateTime?

  submittedAt DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  enrollment CertEnrollment @relation(fields: [enrollmentId], references: [id], onDelete: Cascade)
  step       CertStep       @relation(fields: [stepId], references: [id], onDelete: Cascade)
  reviewer   User?          @relation("CertReviewer", fields: [reviewerId], references: [id])

  @@unique([enrollmentId, stepId])
  @@index([enrollmentId])
  @@index([stepId])
}

model Certificate {
  id           String    @id @default(cuid())
  enrollmentId String    @unique
  token        String    @unique @default(cuid()) // public verification token
  studentName  String // snapshot at issue time
  programTitle String // snapshot at issue time
  level        String
  issuedAt     DateTime  @default(now())
  expiresAt    DateTime?

  enrollment CertEnrollment @relation(fields: [enrollmentId], references: [id], onDelete: Cascade)

  @@index([token])
}
