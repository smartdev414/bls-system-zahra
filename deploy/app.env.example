# The app's runtime secrets → /home/deploy/bls-zahra/app.env on the server (chmod 600).
# Copy each value from Vercel → Project → Settings → Environment Variables
# (Production). Plain KEY=value lines, no quotes.
# DATABASE_URL is NOT set here — docker-compose points the app at the local Postgres.

NODE_ENV=production
NEXT_PUBLIC_APP_URL=https://bsl.deafsigns.co.uk
JWT_SECRET=
CRON_SECRET=

# LiveKit
LIVEKIT_URL=
LIVEKIT_WS_URL=
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=

# Pusher
PUSHER_APP_ID=
PUSHER_SECRET=
NEXT_PUBLIC_PUSHER_KEY=
NEXT_PUBLIC_PUSHER_CLUSTER=

# AWS S3 (uploads, recordings)
AWS_REGION=
AWS_S3_BUCKET=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# Email (Mailgun)
MAILGUN_API_KEY=
MAILGUN_DOMAIN=
MAILGUN_FROM=
MAILGUN_API_BASE=

# Web push
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=

# Google sign-in
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# AI / media services
OPENAI_API_KEY=
CLOUDCONVERT_API_KEY=
RUNPOD_API_KEY=
RUNPOD_BACKGROUND_ENDPOINT_ID=
NEXT_PUBLIC_TLDRAW_LICENSE_KEY=

# Ops alerts (Slack/Discord webhook)
ALERT_WEBHOOK_URL=
